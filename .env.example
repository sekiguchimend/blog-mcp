# NodeFlare blog admin API
#
# Base URL of the NodeFlare API (no trailing slash). The blog admin endpoints
# live under <NODEFLARE_API_URL>/api/v1/blog/admin/...
# NOTE: this is the API host (nodeflare-api.fly.dev), NOT api.nodeflare.tech
# (which routes to the MCP proxy).
NODEFLARE_API_URL=https://nodeflare-api.fly.dev

# Shared admin secret. Must match BLOG_ADMIN_TOKEN set on the API server.
# Generate with: openssl rand -hex 32
BLOG_ADMIN_TOKEN=your_blog_admin_token_here

# Transport: "http" (default, remote Streamable HTTP) or "stdio" (local dev).
MCP_TRANSPORT=http

# HTTP transport only: port/host to bind (NodeFlare injects PORT).
PORT=8080
HOST=0.0.0.0

# Optional. When set, the HTTP /mcp endpoint requires
# `Authorization: Bearer <token>`. On NodeFlare the platform proxy already
# gates access, so leave this unset there; set it for standalone hosting.
# MCP_AUTH_TOKEN=
